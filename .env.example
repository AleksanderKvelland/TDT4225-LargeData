# Copy this file to .env (which is git-ignored) and change the passwords if you like.
# The same file is read by docker-compose.yml (to create the database and user)
# and by DbConnector.py (to connect to it).
#
# NB: MySQL only reads the user/password/database settings the first time the
# container starts. To change them afterwards: docker compose down -v

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=porto
DB_USER=testuser
DB_PASSWORD=test123
MYSQL_ROOT_PASSWORD=root_local_pw
